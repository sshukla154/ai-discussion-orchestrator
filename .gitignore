# --- Claude Code local config: never tracked (see docs/data-handling.md) ---
.claude/

# --- Runtime data: transcripts and DB live OUTSIDE the repo, but belt-and-braces ---
*.db
*.db-wal
*.db-shm
runs/
data/
.env
.env.*
!.env.example

# --- Java / Maven ---
target/
.mvn/timing.properties
*.class
*.war
# Not *.jar: a blanket rule here would also exclude .mvn/wrapper/maven-wrapper.jar, and a
# later negation cannot rescue it. Build output is already covered by target/.
hs_err_pid*
replay_pid*

# --- Node / frontend (later phases) ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# --- OS ---
Thumbs.db
.DS_Store
