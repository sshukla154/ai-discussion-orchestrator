<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.sshukla154</groupId>
  <artifactId>ai-discussion-orchestrator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ai-discussion-orchestrator</name>
  <description>Local-only orchestrator for structured multi-model discussions</description>

  <properties>
    <!-- The Boot parent maps maven.compiler.release from java.version, so this one
         property is the whole story. Boot 4.1.1 supports Java 17-26. -->
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Deliberately NOT spring-boot-starter-web; see AiDiscussionOrchestratorApplication. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>

    <!-- Persistence is test-scoped on purpose. Phase one writes plain files, so nothing in
         main sources may touch a database; the architecture test enforces that. These stay
         declared because the persistence spike is a permanent test and would otherwise stop
         guarding the dialect pairing. They move to compile scope when real entities arrive.

         Versions omitted deliberately: the Boot BOM manages all of them, and the dialect
         artifact must match hibernate-core exactly or the bootstrap fails with
         NoSuchMethodError. Pinning by hand is how that drift starts. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Required, and easy to miss. Spring Boot 4 split autoconfiguration into
         per-technology modules, so flyway-core alone brings no FlywayAutoConfiguration and
         migrations simply never run. The failure is silent: with ddl-auto=update the schema
         would be quietly generated by Hibernate instead of by the migrations. It is only
         visible because ddl-auto=validate turns it into a startup error. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Structural rules that a code review would otherwise have to remember. See
         ArchitectureTest for what is enforced and why each rule exists. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.0</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Hermetic by default: anything tagged "live" spawns the real CLI and
               must never run in CI. Enabled by the "live" profile below. -->
          <excludedGroups>live</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn verify -Plive : runs the real-CLI smoke tests. Local only. -->
      <id>live</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
              <groups>live</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
